# -----------------------------
# TrueSkill API Configuration
# -----------------------------

# URL for the TrueSkill FastAPI service used by server-side controllers.
TRUESKILL_API_URL="http://127.0.0.1:5000"

VITE_TBA_API_KEY="your-tba-api-key"
TBA_AUTH_KEY="replace-with-a-different-key-for-tba"
# FIY: As a fallback if your TBA_AUTH_KEY gets banned trueskill will use the VITE_TBA_API_KEY from above

# Optional: Season year used by automated full rebuild + active-event discovery.
# If missing/invalid, the API falls back to the server local current year.
TRUESKILL_SEASON_YEAR="2026"

# --- Postgres Address ---
TRUESKILL_DB_URI="postgresql://USERNAME:PASSWORD@localhost:port/trueskill"
